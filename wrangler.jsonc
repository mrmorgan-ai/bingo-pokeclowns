{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bingo-pokeclowns",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-15",
  "observability": { "enabled": true },
  "build": { "command": "npm run build" },
  // Static files are served for free without running the Worker; only /api/* invokes it.
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "bingo-pokeclowns",
      // Replace with the id printed by `npx wrangler d1 create bingo-pokeclowns` before deploying.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ]
}
